{
  "name": "@theo/health",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "build:public": "vite build --config vite.public.config.js",
    "deploy:public": "npm run build:public && wrangler deploy",
    "deploy": "npm run deploy:public",
    "check:worker": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "18.0.2",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "google-auth-library": "11.1.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "wrangler": "4.136.1"
  }
}
