---
// The Spotify track playing now, or the last one played. The cover is shown as
// Spotify supplies it; an ink record with the portal as its label slides out
// from behind it and spins while the track plays.
---

<div class="listening" hidden>
  <a class="now-playing" target="_blank" rel="noopener">
    <span class="sleeve">
      <span class="record" aria-hidden="true">
        <img class="label" src="/favicon.svg" alt="" width="12" height="12" />
      </span>
      <img class="cover" alt="" width="36" height="36" />
    </span>
    <span class="track">
      <span class="line"><span class="title"></span> <span class="muted artists"></span></span>
      <span class="label-line"><span class="state"></span> on Spotify</span>
    </span>
  </a>
</div>

<style>
  /* A compact line in the introduction, under the pulse. */
  .listening {
    margin-top: 1rem;
  }
  .now-playing {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    max-width: 100%;
    line-height: 1.4;
  }
  .sleeve {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
  }
  .cover {
    position: relative;
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 3px;
    background: #f4f4f4;
  }
  /* Grooves in ink, with the homepage portal as the centre label. */
  .record {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 5.5px, #141414 6px),
      repeating-radial-gradient(circle, #141414 0 1px, #2b2b2b 1.3px 2px);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .label {
    position: absolute;
    inset: 10px;
    width: 12px;
    height: 12px;
  }
  .now-playing:hover .record {
    transform: translateX(8px);
  }
  /* Out of the sleeve and turning while the track plays; the label turns with it. */
  .listening[data-playing] .record {
    transform: translateX(12px);
    animation: spin-out 1.8s linear infinite;
  }
  @keyframes spin-out {
    from {
      transform: translateX(12px) rotate(0deg);
    }
    to {
      transform: translateX(12px) rotate(360deg);
    }
  }
  .track {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .line {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.875rem;
  }
  .label-line {
    color: var(--label-color);
    font-size: 0.8125rem;
  }
  .listening[data-playing] .state::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--heading-color);
    vertical-align: 0.1em;
    animation: breathe 1.6s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .record,
    .state::before {
      animation: none !important;
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.listening');
  const link = section?.querySelector<HTMLAnchorElement>('.now-playing');
  const ago = (iso: string) => {
    const minutes = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60000));
    if (minutes < 2) return 'just now';
    if (minutes < 60) return `${minutes} minutes ago`;
    const hours = Math.round(minutes / 60);
    if (hours < 24) return hours === 1 ? 'an hour ago' : `${hours} hours ago`;
    const days = Math.round(hours / 24);
    return days === 1 ? 'yesterday' : `${days} days ago`;
  };
  type Track = { title: string; artists: string[]; image: string | null; url: string | null };
  type Listening = { playing: boolean; playedAt?: string | null; track: Track | null };

  async function update() {
    if (!section || !link || document.hidden) return;
    try {
      const response = await fetch('/api/now-playing');
      if (!response.ok) return;
      const data: Listening = await response.json();
      if (!data.track) return;
      const { track } = data;
      section.toggleAttribute('data-playing', data.playing);
      link.href = track.url || 'https://open.spotify.com';
      const cover = link.querySelector<HTMLImageElement>('.cover')!;
      if (track.image && cover.src !== track.image) cover.src = track.image;
      cover.alt = `Cover of ${track.title}`;
      link.querySelector('.title')!.textContent = track.title;
      link.querySelector('.artists')!.textContent = `· ${track.artists.join(', ')}`;
      link.querySelector('.state')!.textContent = data.playing
        ? 'Playing now'
        : `Played ${data.playedAt ? ago(data.playedAt) : 'recently'}`;
      section.hidden = false;
    } catch {
      // Leave the section as it was; it stays hidden until a track loads.
    }
  }
  update();
  setInterval(update, 60000);
  document.addEventListener('visibilitychange', update);
</script>
