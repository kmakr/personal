<ink-mark class="mark" aria-hidden="true" data-ink-state="static">
  <picture class="still"
    ><source srcset="/mark-dark.png" media="(prefers-color-scheme: dark)" /><img
      src="/mark.png"
      alt=""
      width="96"
      height="96"
    /></picture
  >
  <canvas width="192" height="192"></canvas>
</ink-mark>

<style>
  ink-mark.mark {
    position: relative;
    flex: none;
    width: 96px;
    height: 96px;
    margin-left: -12px;
  }

  img,
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease-out;
  }

  /* The still image is only a fallback, and it looks unlike the live portal, so
     it waits: it appears only if the portal hasn't drawn within 1.5 seconds (no
     WebGL, or the script failed), and at once when motion is reduced. The live
     portal fades in, so a refresh never flashes the still mark first. */
  img {
    opacity: 0;
    animation: ink-fallback 0s 1.5s forwards;
  }

  @keyframes ink-fallback {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      opacity: 1;
      animation: none;
    }
  }

  ink-mark[data-rendered] img {
    opacity: 0;
    animation: none;
  }

  ink-mark[data-rendered] canvas {
    opacity: 1;
  }
</style>

<script>
  import '../scripts/ink-mark';
</script>
