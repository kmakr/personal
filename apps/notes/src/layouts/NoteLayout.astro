---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const { id, title, summary, date, draft = false } = Astro.props;
// Matches the homepage list, so the title travels from there into place here.
const titleName = id ? `note-${id.replace(/[^a-z0-9-]/gi, '-')}` : undefined;
const dateText = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout title={`${title} — Theo Azriel`} description={summary} noindex={draft}>
  <SiteHeader />
  <main>
    <article class="post">
      {
        draft && (
          <p class="draft-banner">
            Draft preview — this note is unlisted until <code>draft: false</code>.
          </p>
        )
      }
      <h1>
        <span
          class="note-title"
          style={titleName ? `view-transition-name: ${titleName}` : undefined}>{title}</span
        >
      </h1>
      <p class="note-summary">{summary}</p>
      <p class="note-meta"><time datetime={date.toISOString()}>{dateText}</time></p>
      <div class="prose"><slot /></div>
    </article>
  </main>
</BaseLayout>

<script>
  import '../scripts/ink-drops';
</script>
