---
import '../styles/global.css';

const {
  title = 'Theo Azriel',
  description = 'Photographs, notes, and things built for the web by Theo Azriel.',
  noindex = false,
  footer = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {
      /* Moving between pages animates (see global.css). The opt-in sits first
         and inline because the page arrives in pieces: Chrome checks for it as
         soon as it can, and skips the animation if the stylesheet link hasn't
         arrived yet. The new page also waits until it has fully arrived, so it
         is never caught half-built. */
    }
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    <link rel="expect" href="#page-end" blocking="render" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Theo Azriel — Notes" href="/feed.xml" />
    <title>{title}</title>
    <script is:inline>
      // Following a link on this site, the next page spreads in like ink from
      // where the link was pressed. The point is handed over for a few seconds
      // only, so a later back or reload simply fades.
      addEventListener('click', (event) => {
        const link = event.target instanceof Element && event.target.closest('a[href]');
        if (!link || link.origin !== location.origin || link.target) return;
        const box = link.getBoundingClientRect();
        // A keyboard press has no pointer position; the link's middle stands in.
        const keyed = event.detail === 0;
        const point = {
          x: Math.round(keyed ? box.left + box.width / 2 : event.clientX),
          y: Math.round(keyed ? box.top + box.height / 2 : event.clientY),
          time: Date.now(),
        };
        try {
          sessionStorage.setItem('ink-from', JSON.stringify(point));
        } catch {
          // Without storage the page just fades in.
        }
      });
      addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        let point = null;
        try {
          point = JSON.parse(sessionStorage.getItem('ink-from') || 'null');
          sessionStorage.removeItem('ink-from');
        } catch {
          return;
        }
        if (!point || Date.now() - point.time > 4000) return;
        const root = document.documentElement;
        root.style.setProperty('--ink-x', `${point.x}px`);
        root.style.setProperty('--ink-y', `${point.y}px`);
        root.dataset.inkBloom = '';
        event.viewTransition.finished.finally(() => {
          delete root.dataset.inkBloom;
          root.style.removeProperty('--ink-x');
          root.style.removeProperty('--ink-y');
        });
      });
    </script>
  </head>
  <body>
    <slot />
    {
      footer && (
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} Theo Azriel</span>
        </footer>
      )
    }
    <div id="page-end" hidden></div>
  </body>
</html>
