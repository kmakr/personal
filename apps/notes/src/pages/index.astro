---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InkMark from '../components/InkMark.astro';
import NowPlaying from '../components/NowPlaying.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
// The name a note's title carries from this list into its own page.
const titleName = (id: string) => `note-${id.replace(/[^a-z0-9-]/gi, '-')}`;
const dateText = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
---

<BaseLayout>
  <main class="home">
    <header class="home-intro">
      <h1>
        <InkMark />
        <span class="wordmark">Theo Azriel</span>
      </h1>
      <p class="muted">Photographs, notes, and things built for the web.</p>
      <p class="pulse-line" hidden>
        The portal beats at <a href="/health/"><span class="bpm"></span> a minute</a>, my resting
        heart rate on <span class="bpm-date"></span>.
      </p>
      <NowPlaying />
    </header>

    <section class="projects" aria-label="Projects">
      <h2>Projects</h2>
      <a class="item" href="https://home.theoazriel.com">
        <span>Home</span>
        <span class="muted">A quiet room of sunlight, with leaves moving on the wall.</span>
        <span class="peek peek-home" aria-hidden="true">
          <svg viewBox="0 0 84 52">
            <g class="leaf-shadows">
              <ellipse cx="14" cy="10" rx="9" ry="4" transform="rotate(-30 14 10)"></ellipse>
              <ellipse cx="30" cy="6" rx="7" ry="3" transform="rotate(20 30 6)"></ellipse>
              <ellipse cx="24" cy="22" rx="8" ry="3.5" transform="rotate(-50 24 22)"></ellipse>
              <ellipse cx="44" cy="14" rx="6" ry="2.6" transform="rotate(35 44 14)"></ellipse>
              <ellipse cx="8" cy="30" rx="6" ry="2.8" transform="rotate(10 8 30)"></ellipse>
              <path d="M-4 2 Q20 14 52 8"></path>
            </g>
          </svg>
        </span>
      </a>
      <a class="item" href="/health/">
        <span>Health</span>
        <span class="muted">A garden of my steps and sleep, with a moth and a heartbeat.</span>
        <span class="peek peek-health" aria-hidden="true"></span>
      </a>
      <a class="item" href="https://gallery.theoazriel.com">
        <span>Gallery</span>
        <span class="muted">Photographs. Places, mostly quiet ones.</span>
        <span class="peek peek-gallery" aria-hidden="true"
          ><img alt="" width="72" height="48" /></span
        >
      </a>
    </section>

    <section aria-label="Notes">
      <h2>Notes</h2>
      {
        notes.map((note) => (
          <a class="item" href={`/notes/${note.id}`}>
            <span class="item-title" style={`view-transition-name: ${titleName(note.id)}`}>
              {note.data.title}
            </span>
            <span class="muted">{note.data.summary}</span>
            <time datetime={note.data.date.toISOString()}>{dateText(note.data.date)}</time>
          </a>
        ))
      }
    </section>

    <section aria-label="Elsewhere">
      <h2>Elsewhere</h2>
      <p class="inline-links">
        <a href="https://github.com/kmakr">GitHub</a>
        <a href="mailto:theo.azriel@icloud.com">Email</a>
        <a href="/feed.xml">RSS</a>
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  import '../scripts/home';
</script>
