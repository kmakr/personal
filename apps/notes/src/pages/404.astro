---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Theo Azriel" noindex footer={false}>
  <main class="not-found">
    <a href="/" aria-label="Theo Azriel home"
      ><picture class="still"
        ><source srcset="/mark-dark.png" media="(prefers-color-scheme: dark)" /><img
          class="nf-mark"
          src="/mark.png"
          alt=""
          width="160"
          height="160"
        /></picture
      ></a
    >
    <p class="nf-line">404 — nothing here</p>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .nf-mark {
    display: block;
  }

  .nf-line {
    margin: 3.5rem 0 0;
    font-size: 19px;
    font-weight: 500;
  }
</style>
