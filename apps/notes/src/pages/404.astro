---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Theo Azriel" noindex footer={false}>
  <main class="not-found">
    <a href="/" aria-label="Theo Azriel home"
      ><img class="nf-mark" src="/favicon.svg" alt="" width="160" height="160" /></a
    >
    <p class="nf-line">404 — nothing here</p>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .nf-mark {
    display: block;
  }

  .nf-line {
    margin: 3.5rem 0 0;
    font-size: 19px;
    font-weight: 500;
  }
</style>
