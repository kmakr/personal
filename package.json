{
  "name": "theoazriel-web",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter './apps/*' build",
    "build:gallery": "bun run --cwd apps/gallery build",
    "build:notes": "bun run --cwd apps/notes build",
    "check": "bun run format:check && bun run lint && bun run build && bun run check:workers && bun run check:health",
    "check:workers": "bun run --cwd apps/home wrangler deploy --dry-run && bun run --cwd apps/cms-auth wrangler deploy --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "dev:home": "bun run --cwd apps/home dev",
    "dev:notes": "bun run --cwd apps/notes dev",
    "dev:gallery": "bun run --cwd apps/gallery dev",
    "dev:cms-auth": "bun run --cwd apps/cms-auth dev",
    "deploy:home": "bun run --cwd apps/home deploy",
    "deploy:gallery": "bun run --cwd apps/gallery deploy",
    "deploy:notes": "bun run --cwd apps/notes deploy",
    "deploy:cms-auth": "bun run --cwd apps/cms-auth deploy",
    "dev:health": "bun run --cwd apps/health dev",
    "build:health": "bun run --cwd apps/health build",
    "build:health:public": "bun run --cwd apps/health build:public",
    "test:health": "bun run build:health && bun run --cwd apps/health test",
    "deploy:health": "bun run --cwd apps/health deploy",
    "check:health": "bun run build:health:public && bun run test:health && bun run --cwd apps/health check:worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "bun@1.4.2"
}
